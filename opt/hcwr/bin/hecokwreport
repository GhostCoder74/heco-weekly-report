def get_calendar_week(date_str):
    """
    Gibt die Kalenderwoche (ISO 8601) zu einem Datum im Format 'YYYY-MM-DD' zurück.
    Rückgabe: (jahr, kw) als Tuple
    """
    try:
        date_obj = datetime.strptime(date_str, "%Y-%m-%d").date()
        iso_year, iso_week, _ = date_obj.isocalendar()
        return iso_year, iso_week
    except ValueError:
        raise ValueError("Ungültiges Datumsformat. Erwartet: YYYY-MM-DD")

def get_or_create_projects_id_map():
    """
    Erstellt oder holt sich die ID Map zu den Projects für heco time.db und speichert sie in die Config
    """
    if os.path.exists(config_file):
        config.read(config_file)
    else:
        config['ProjectIDs'] = {}

    if 'ProjectIDs' not in config:
        info("Es fehlen noch Config Einträge zu : ", 'ProjectIDs')
        config['ProjectIDs'] = {}

    # Wenn Map-Einträge fehlen, abfragen
    pids = projects_id_map
    updated = False
    set_default_map = False
    missing_map = False
    for ptitel, pid in pids.items():
        if ptitel not in config['ProjectIDs']:
            missing_map = True
    if missing_map:
        prompt  = (f"Möchten sie die Default Map-Einträg für die Projekt IDs verwenden? [J/n]: ")
        answer = input_with_prefill(prompt, "", "")
        print("\n")
        if answer in ("", "j", "ja", "y", "yes"):
            set_default_map = True
    else:
        set_default_map = True

    for ptitel, pid in pids.items():
        if ptitel not in config['ProjectIDs']:
            if set_default_map == False:
                prompt = (f"Titel: {ptitel} = ID: ")
                value = input_with_prefill(prompt, str(pid)).strip()
                config['ProjectIDs'][ptitel] = value
            else:
                config['ProjectIDs'][ptitel] = str(pid)
            updated = True

    # Falls etwas geändert wurde, Config schreiben
    if updated:
        update_config(config)

    # Map in Float-Werte konvertieren und zurückgeben
    new_projects_id_map = {
        ptitel: int(config['ProjectIDs'][ptitel])
        for ptitel in config['ProjectIDs']
    }
    if int(DBG_LEVEL)==-1:
        debug(f"new_projects_id_map = {new_projects_id_map}")
    return new_projects_id_map

def get_or_create_wdayhours_map():
    """
    Erstellt oder holt sich die Wochentag-Arbeitsstunden-Map, wird benötigt umd Tageabweichungen zu prüfen.
    """

    if os.path.exists(config_file):
        config.read(config_file)
    else:
        config['Workdays'] = {}

    if 'Workdays' not in config:
        info("Es fehlen noch Config Einträge zu : ", 'Workdays')
        config['Workdays'] = {}

    # Wenn Map-Einträge fehlen, abfragen
    weekdays = ['Mo', 'Di', 'Mi', 'Do', 'Fr']
    updated = False
    for day in weekdays:
        if day not in config['Workdays']:
            while True:
                prompt = (f"Wieviele Stunden arbeiten Sie am {day}? (z. B. 8.0): ")
                value = input_with_prefill(prompt, str(8.0)).strip()
                if not value:
                    print("Eingabe darf nicht leer sein.")
                    continue
                try:
                    float_val = float(value)
                    config['Workdays'][day] = str(float_val)
                    updated = True
                    break
                except ValueError:
                    print("Bitte eine gültige Zahl eingeben (z. B. 8.0 oder 7.5).")

    # Falls etwas geändert wurde, Config schreiben
    if updated:
        update_config(config)
    # Map in Float-Werte konvertieren und zurückgeben
    wdayhours_map = {day: float(config['Workdays'][day]) for day in weekdays}
    return wdayhours_map

def set_default_cons(interactive=False):
    """
    Setzt die Path Kosntanten in der Config (Default oder interaktiv)
    """
    global config_file


    config['Database']['db_keyword_id_path'] = db_keyword_id_path
    config['General']['kw_report_base_dir'] = kw_report_base_dir
    config['General']['sql_template'] = sql_template
    config['General']['wf_check_path'] = wf_check_path
    if interactive:
        for sec, cons_path in [
            ("Database", "db_keyword_id_path"),
            ("General", "kw_report_base_dir"),
            ("General", "sql_template"),
            ("General", "wf_check_path")
        ]:
            prompt = (f"['{sec}']['{cons_path}']: ")
            value = input_with_prefill(prompt, config[sec].get(cons_path, ''))
            config[sec][cons_path] = value
            # globale Variable aktualisieren
            globals()[CONFIG_KEY_TO_GLOBAL_VAR[cons_path]] = value

    update_config(config)


def get_config(call_from=None):
    """
    Ließt bzw. initialisiert die Config "config_file"
    """
    if int(DBG_LEVEL)<=0:
        stack = inspect.stack()
        caller = stack[1]  # Der direkte Aufrufer
        debug(f"Aufgerufen von: Zeile {caller.lineno}")
        if int(DBG_LEVEL)==-1:
            debug(f"get_config was called from: {call_from}")
    global db_keyword_id_path, kw_report_base_dir, sql_template, wf_check_path
    if not os.path.exists(config_file):
        set_weekhours()
        set_first_workday()

    config.read(config_file)

    if 'Onboarding' not in config or 'firstday' not in config['Onboarding']:
        info("Es fehlt noch Eintrag zum 1. Arbeitstag bzw. 1. Tag der Nutzung", '')
        set_first_workday()

    if 'General' not in config or 'weekhours' not in config['General']:
        info("Es fehlt noch Eintrag zu den Arbeitsstunden pro Kalendarwoche", '')
        set_weekhours()

    if 'Database' not in config or 'dbpath' not in config['Database']:
        info("Es fehlt noch der Pfad zur heco Datenbank", '')
        set_heco_db_path()

    # Nach den möglichen Änderungen nochmal lesen
    config.read(config_file)

    # Konstanten einlesen, wenn vorhanden:
    # Konstante Pfade:
    if 'General' in config and 'Database' in config:
        if "db_keyword_id_path" in config['Database']:
            db_keyword_id_path = os.path.expanduser(config['Database']['db_keyword_id_path'])
            if int(DBG_LEVEL)==-1:
                debug(f"db_keyword_id_path = {db_keyword_id_path}")
        if "kw_report_base_dir" in config['General']:
            kw_report_base_dir = os.path.expanduser(config['General']['kw_report_base_dir'])
            if int(DBG_LEVEL)==-1:
                debug(f"kw_report_base_dir = {kw_report_base_dir}")
        if "sql_template" in config['General']:
            sql_template = os.path.expanduser(config['General']['sql_template'])
            if int(DBG_LEVEL)==-1:
                debug(f"sql_template = {sql_template}")
        if "wf_check_path" in config['General']:
            wf_check_path = os.path.expanduser(config['General']['wf_check_path'])
            if int(DBG_LEVEL)==-1:
                debug(f"wf_check_path = {wf_check_path}")

        if (
                call_from == "no_config"
                and not "kw_report_base_dir" in config['Database']
                and not "sql_template" in config['General']
                and not "wf_check_path" in config['General']
        ):
            prompt  = (f"Möchten sie die Default Path Konstanten für hecokwreport verwenden oder interaktiv setzen? [J / n /i = interactive]: ")
            answer = input_with_prefill(prompt, "", "")
            print("\n")
            if answer in ("", "i", "j", "ja", "y", "yes"):
                if answer == "i":
                    set_default_cons(True)
                else:
                    set_default_cons(False)

    weekhours = int(config['General']['weekhours'])
    args.database = os.path.expanduser(config['Database']['dbpath'])
    firstday = config['Onboarding']['firstday']
    if int(DBG_LEVEL)==-1:
        debug (f"firstday = {firstday}")
    year, week = get_calendar_week(firstday)

    if year != date.today().year:
        return weekhours, 1
    else:
        return weekhours, week

def set_weekhours():
    """
    Setzt in der Config die Wochenarbeitsstunden, wird zur Berechung von Über- bzw. Unterstunden benötigt.
    """
    # Benutzer nach den Wochenstunden fragen
    weekhours = input("Bitte ihre Wochenarbeitsstunden eingeben: ")

    # Wochenstunden in Sekunden umwandeln
    weekhours_seconds = int(weekhours) * 3600

    # Neue Konfigurationsdatei erstellen
    if not "General" in config:
        config['General'] = {}
    if not "weekhours" in config['General']:
        config['General']['weekhours'] = str(weekhours_seconds // 3600)  # In Stunden speichern

    # Konfigurationsdatei speichern
    update_config(config)

def set_heco_db_path():
    """
    Setzt den Pfad zur heco time.db -> "db_path"
    """
    # Benutzer nach dem Pfad zur Datenbank fragen
    db_path = input_with_prefill("Bitte Pfad zu heco Datenbank eintragen: ", args.database)
    debug(f"db_path = {db_path}")

    if not "Database" in config:
        config['Database'] = {}
    if not "dbpath" in config['Database']:
        config['Database']['dbpath'] = db_path

    # Konfigurationsdatei speichern
    update_config(config)
    info(f"Config file updated with path: ", db_path)

def configure_interactive():
    """
    Gibt dem Benutzer die Config interaktive zu bearbeiten bzw. sich anzeigen zu lassen.
    """
    info("Interaktive Konfigurationsbearbeitung:\n", "(Enter-Taste, um Wert zu behalten)\n")
    get_config("configure_interactive")
    config.read(config_file)

    for section in config:
        set_val = True
        prompt = None
        if "ProjectIDs" in section:
            prompt  = (f"Möchten sie die bereits gesetzten Map-Einträg für die Projekt IDs bearbeiten? [j/N]: ")
        elif "Workdays" in section:
            prompt  = (f"Möchten sie die bereits gesetzten Arbeitsstunden pro Tag bearbeiten? [j/N]: ")
        elif "Onboarding" in section:
            prompt  = (f"Möchten sie den bereits gesetzten Tag des 1. Arbeitstages bzw. 1. Tag der Nutzung bearbeiten? [j/N]: ")
        elif "General" in section:
            prompt  = (f"Möchten sie die bereits gesetzten Wochenarbeitsstunden bearbeiten? [j/N]: ")
        elif "Database" in section:
            prompt  = (f"Möchten sie die bereits gesetzten Pfad der Datenbank bearbeiten? [j/N]: ")

        if prompt:
            answer = input_with_prefill(prompt, "", "")
            print ("\n")
            if answer in ("", "n", "nein", "n", " no"):
                set_val = False
        else:
            get_or_create_wdayhours_map()
            get_or_create_projects_id_map()

        for key in config[section]:
            current_value = config[section][key]
            if set_val:
                new_value = input_with_prefill(f"[{section}] {key}: ", current_value)
            else:
                if "ProjectIDs" in section:
                    info(f" {current_value} ->", f" {key}", f"[{section}]")
                else:
                    info(f" {key} :", f" {current_value}", f"[{section}]")
                new_value = current_value
            if new_value.strip() and new_value.strip() != current_value:
                config[section][key] = new_value.strip()
        if prompt:
            print ("\n")

    update_config(config)

def set_first_workday():
    """
    Setzt den  1. Arbeitstag bzw. 1. Tag der Nutzung von heco time.db.
    Wichtig für die Stundenberechnung (Zeitkonto, Abwesendheit, Urlaub, etc.)
    """
    if os.path.exists(config_file):
        config.read(config_file)

    # Benutzer nach den ersten Arbeitstag fragen
    firstday = input("Bitte ihre 1. Arbeitstag bzw. 1. Tag der Nutzung eingeben (Format = YYYY-MM-DD): ")

    if not "Onboarding" in config:
        config['Onboarding'] = {}

    if not "firstday" in config['Onboarding']:
        config['Onboarding']['firstday'] = str(firstday)

    # Konfigurationsdatei speichern
    update_config(config)
    info(f"Config file updated with firstday: {firstday}")

def update_config(new_config):
    """
    Vergleicht übergebenes ConfigParser-Objekt (new_config) mit der Datei
    und schreibt die Datei neu, wenn Änderungen vorhanden sind.
    """
    # Originale Konfiguration aus Datei einlesen
    old_config = configparser.ConfigParser()
    old_config.optionxform = str

    if not os.path.exists(config_file):
        warning(f"Config file not found! Creating now: ", config_file, "Info")
        with open(config_file, 'w') as configfile:
            old_config.write(configfile)
    old_config.read(config_file)

    changed = False  # Flag, ob Änderungen erkannt wurden

    # Alle Sektionen und Keys aus dem neuen Config-Objekt prüfen
    for section in new_config.sections():
        if section not in old_config:
            old_config[section] = {}
            changed = True

        for key, value in new_config[section].items():
            if (
                section not in old_config or
                key not in old_config[section] or
                old_config[section][key] != value
            ):
                old_config[section][key] = value
                changed = True

    if changed:
        with open(config_file, 'w') as f:
            old_config.write(f)
        info(f"Konfiguration aktualisiert und gespeichert nach: ", config_file)
    else:
        info("Keine Änderungen an der Konfiguration vorgenommen.", "")

def isoweek(date_string, year, week):
    """
    SQLite Funktion für die Timestamps in heco time.db
    """
    try:
        d = datetime.strptime(date_string, "%Y-%m-%d").isocalendar()
        return d[0] == int(year) and d[1] == int(week)
    except:
        return False

def get_weekday_hours_per_day(conn, year, week):
    """
    Returns total hours for Mo–Fr in the specified calendar week and year.

    :param conn: db connection
    :param year: integer (e.g. 2024)
    :param week: integer (1–53)
    :return: tuple of Decimal values (Mo, Di, Mi, Do, Fr)
    """
    sql = wdayhours_sql + queries.wdayhours_sql_excl

    cursor = conn.cursor()
    if config.has_option("Database", "dbms") and config.get("Database", "dbms") == "pg":
        cursor.execute(sql, [week, week])
    else:
        cursor.execute(sql, [year, week, year, week])
    row = cursor.fetchone()

    # Convert to Decimals and ensure fallback to 0.0 if None
    return tuple(Decimal(val) if val is not None else Decimal("0.0") for val in row)

def get_kw_overhours(kw):
    # TODO: overhours hier implementieren
    """
    Berechnnet die Überstunden zur angegebenen Kalendarwochen "kw"
    """
    cmd = ["overhours", "-kw", str(kw)]
    result = subprocess.run(cmd, capture_output=True, text=True)
    match = re.search(r"Summe:\s*([+-]?\d+):(\d+):\d+", result.stdout)
    if match:
        h, m = match.groups()
        return Decimal(h) + Decimal(m) / 60
    return Decimal("0")

def get_kw_overhours_add(kw):
    # TODO: hkwreport hier implementieren
    """
    Holt sich den den Wert aus der Ausgabezeile von hkwreport "KW Zeitkonto:" zur angegebenen Kalendarwochen "kw"
    """
    if int(DBG_LEVEL)==1:
        debug (f"kw = {kw}")
    cmd = ["hkwdreport", "-kw", str(kw), "-zk"]
    result = subprocess.run(cmd, capture_output=True, text=True)
    match = re.search(r"KW Zeitkonto:\s*([+-]?)(\d+):(\d+):\d+", result.stdout)
    if match:
        sign, h, m = match.groups()
        if int(DBG_LEVEL)==-100:
            debug(f"get_kw_overhours_add : sign={sign}, h={h}, m={m}")
        stunden = float(Decimal(h) + Decimal(m) / 60)
        return sign, stunden
    return "+", float(Decimal("0"))

def berechne_abwesenheiten(conn, year, week):
    """
    Berechnen Sie die Abwesenheitszeiten pro Kategorie.
    """
    cursor = conn.cursor()
    result = {key: 0.0 for key in mapping}
    sql = queries.absence
    if config.has_option("Database", "dbms") and config.get("Database", "dbms") == "pg":
        cursor.execute(sql, [week, week])
    else:
        cursor.execute(sql, [year, week, year, week])
    rows = cursor.fetchall()
    for desc, stunden in rows:
        desc = desc.strip()
        for key, keywords in mapping.items():
            if any(desc.startswith(word) for word in keywords):
                result[key] += stunden
                break
    return result

# Check if wday is Krank, Urlaub, Feiertag
def has_wday_absence(conn, weekday_num, year, week):
    """
    Checks if there are any entries for 'Krank', 'Urlaub' or 'Feiertag' on a given weekday.

    :param conn: db connection
    :param weekday_num: '1' = Mo, '2' = Di, ..., '5' = Fr
    :param year: ISO year
    :param week: ISO calendar week
    :return: True if there are any such entries on that weekday
    """
    sql = queries.wday_absence
    cursor = conn.cursor()
    if config.has_option("Database", "dbms") and config.get("Database", "dbms") == "pg":
        cursor.execute(sql, [week, week, weekday_num])
    else:
        cursor.execute(sql, [year, week, year, week, weekday_num])
    count = cursor.fetchone()[0]
    return count > 0

def get_wday_diff(conn, wdays, year, week):
    """Collect and print weekday deviations only if there are any."""
    lines = [""]
    default_comment = REMINDER_TXT

    for dayname, stunden in wdays.items():
        try:
            stunden = Decimal(stunden)
        except (InvalidOperation, TypeError):
            stunden = Decimal("0.0")

	# Map German weekday names to SQLite weekday numbers
        weekday_map = {"Mo": "1", "Di": "2", "Mi": "3", "Do": "4", "Fr": "5"}
        weekday_num = weekday_map[dayname]

        # Skip if the day has only absence entries
        if has_wday_absence(conn, weekday_num, year, week):
            continue

        # Check for deviation from expected hours
        expected = Decimal(wdayhours_map[dayname])

        # Prüfen ob Abweichung größer als ±WD_TOLERANCE
        lower_bound = expected * Decimal(1 - WD_TOLERANCE)
        upper_bound = expected * Decimal(1 + WD_TOLERANCE)

        if stunden < lower_bound or stunden > upper_bound:
            if stunden < 10 and stunden > 0:
                hourstr = f" {format_decimal(round(stunden, 2))}  {default_comment}"
            elif stunden == 0:
                hourstr = f" {format_decimal(round(stunden, 0))}  * Überstundenabbau ???"
            else:
                hourstr = f"{format_decimal(round(stunden, 2))}  {default_comment}"
            lines.append(f"Tagabweichung: {dayname}: {hourstr}")

    if lines:
        return "\n".join(lines)

# Prepare SQL query
def merge_results(result):
    """
    Fügt die Daten entsprechend des geforderten Formats von Wochenfazit zusammen zur weiteren Verabeitung.
    """
    merged = {}

    # Phase 1: Sammeln und aufsummieren
    if int(DBG_LEVEL) == -1:
        debug(f"result = {result}")
        debug(f"===============================================")
    for entry in result:
        if int(DBG_LEVEL) == -1:
            debug(f"entry = {entry}")
            debug(f"------------#############################################--------------")
        desc = entry['description']
        dur = entry['duration'] or 0.0
        uuk = entry['uuk']
        uuk_dur = 0.0
        if uuk == None:
            uuk = []
        if int(DBG_LEVEL) == -1:
            debug(f"uuk = {uuk}")
            debug(f"--------------------------")
        for u in uuk:
            if isinstance(u, dict) and u.get('duration') is not None:
                uuk_dur += float(u['duration'])

        if desc not in merged:
            if config.has_option("Database", "dbms") and config.get("Database", "dbms") == "pg":
                merged[desc] = {'duration': 0.0, 'uuk': []}
            else:
                merged[desc] = {'duration': 0.0, 'uuk': None}

            if 'task' in entry:
                merged[desc]['task'] = entry['task']
            if 'contract_id' in entry:
                merged[desc]['contract_id'] = entry['contract_id']
        merged[desc]['duration'] += float(dur)

        if uuk:
            merged[desc]['uuk'] = uuk

    # Phase 2: Neuaufbau der Ergebnisliste
    final_result = []
    for description in merged:
        i = {
            'description': description,
            'duration': merged[description]['duration'],
            'uuk': merged[description]['uuk'],
        }
        if 'task' in merged[description]:
            i['task'] = merged[description]['task']
        if 'contract_id' in merged[description]:
            i['contract_id'] = merged[description]['contract_id']
        final_result.append(i)
        if int(DBG_LEVEL) == -1:
            debug(f"final_result = {final_result}")
            debug(f"****************************************************")
    return final_result

def get_project_id(cursor, category):
    """
    Holt sich die ID zu einer "category" aus der heco time.db
    """
    category = f"%{category}%"
    cursor.execute(queries.pid_by_description, (category,))  # <-- Tupel mit Komma
    result = cursor.fetchone()
    if int(DBG_LEVEL) == 6:
        debug(f"result = {result}")
    return  result[0] if result else None

def get_UK_and_UUK(conn, base_sql, category, params):
    """
    Bereitet die Daten soweit auf und sortiert sie so, dass sie in dem geforderten Format für das Wochenfazit verarbeitbar sind.
    """
    pid = projects_id_map[category.strip()]
    if int(DBG_LEVEL) == 6:
        debug(f"pid = {pid}")
    sql_query = base_sql.replace(
            "SELECT",
            "SELECT e.start_time AS entry_start_time, e.id AS entry_id, e.description AS entry,"
            )

    sql_query = sql_query.replace(
            "GROUP BY p.id, p.key, p.description",
            f"WHERE p.id = {str(pid)} GROUP BY p.id, p.key, p.description, e.description"
            )
    cursor = conn.cursor()
    cursor.execute(sql_query, params)
    result_rows = cursor.fetchall()
    if int(DBG_LEVEL) == 4 or int(DBG_LEVEL) == -2:
        debug(f"sql_query = {sql_query}\nresult_rows for [{category.strip()}] = {result_rows}")
    uk_entry = []
    for entry_start_time, entry_id, entry, uuk, duration in result_rows:
        if int(DBG_LEVEL)==-10:
            info(f"uuk = {uuk}\ncategory = {category}")
        if uuk == category:
            if int(DBG_LEVEL) == 4:
                debug(f"entry = {entry}, uuk = {uuk}, duration = {duration}")
            line = f"  {entry}:"
            m = contract_pattern.match(line)
            contract = get_contract_id(entry)
            if int(DBG_LEVEL)==-10:
                info(f"line = {line}\nentry = {entry}\ncontract = {contract}")
            if int(DBG_LEVEL) == -2 and contract != None and contract.get('contract_id') not in entry and not m and entry != None:
                debug(f"contract_id = {contract}\nentry = {entry}")
            if contract != None and contract.get('contract_id') not in entry and not m and entry != None:
                entry = f"{entry} {contract.get('contract_id')}"
            if int(DBG_LEVEL) == -2:
                debug(f"contract_id = {contract}\nAFTER CHECK entry = {entry}")
            line = f"  {entry}:"
            m = contract_pattern.match(line)
            if int(DBG_LEVEL) == -98:
                debug(f"get_UK_and_UUK [contract] -> contract: {contract}")
            if not m and entry != None:
                warning(f"  {entry}"," <- Missing contract no in entry")
                prompt  = (f"Möchten sie den Eintrag hier nun korrigieren? {entry}? [J/n]: ")
                answer = input_with_prefill(prompt, "", "")
                if answer in ("", "j", "ja", "y", "yes"):
                    entry_new = input_with_prefill("Bearbeiten von : ", entry)
                    info("Changed entry : ", entry_new)
                    if entry != entry_new:
                        prompt = (f"Möchten Sie den/die Einträge auch in der heco time.db für " +
                                            get_fore_color("YELLOW") + Style.BRIGHT +
                                            f"{args.year} KW {args.week}" + Style.RESET_ALL +
                                            f" nun korrigieren? {entry}? [j/N]: ")

                        answer = input_with_prefill(prompt, "", "")
                        if answer in ("j", "ja", "y", "yes"):
                            sql_params = [entry_new, entry, monday.strftime("%Y-%m-%d"), sunday.strftime("%Y-%m-%d")]
                            cursor.execute(queries.update_entry, sql_params)
                            conn.commit()
                        else:
                            print()
                            info("Keine Änderung vorgenommen für " +
                                 get_fore_color("YELLOW") + Style.BRIGHT +
                                 f"{args.year} KW {args.week} von Entry " +
                                 get_fore_color("BLUE")
                                 + f"{entry}" + Style.RESET_ALL + " in : ",
                                 "heco time.db")
                        entry = entry_new
            added = False
            for e in uk_entry:
              if (
                      contract is not None and
                      e.get('contract_id') is not None and
                      contract.get('contract_id') in e.get('contract_id')
              ):

                    e['duration'] += duration
                    e['description'] = f"{contract.get('keyword')} {contract.get('task')} {contract.get('contract_id')}" if contract is not None else e['description']
                    added = True
                    if int(DBG_LEVEL) == -98:
                        debug(f"get_UK_and_UUK [TOTALED BY CONTRACT] -> uk_entry : {uk_entry}")
                    break
            if not added:
                if int(DBG_LEVEL) == -98:
                    debug(f"get_UK_and_UUK [ADDED] -> entry : {entry}, uuk: {uuk.strip()}, duration: {duration}, contract: {contract}")

                if contract is not None:
                    entry = f"{contract.get('keyword')} {contract.get('task')} {contract.get('contract_id')}"
                if int(DBG_LEVEL) == -98:
                    debug(f"get_UK_and_UUK [DESC CHANGED TO CONTRACT DESC] -> entry : {entry}, uuk: {uuk.strip()}, duration: {duration}, contract: {contract}")

                uk_entry.append({
                    "entry": entry,
                    "uuk": uuk.strip(),
                    "duration": duration,
                    "contract_id": contract.get('contract_id') if contract is not None else None,
                    "task": contract.get('task') if contract is not None else None
                })

    if int(DBG_LEVEL) == -98:
        debug(f"get_UK_and_UUK: uk_entry = {uk_entry}")
    if uk_entry:
        return uk_entry

if os.path.exists(config_file):
